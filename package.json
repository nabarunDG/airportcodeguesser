{
  "name": "gate-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "data:refresh": "node scripts/trim-data.mjs",
    "pages:dev": "npm run build && wrangler pages dev ./dist",
    "d1:migrate:local": "wrangler d1 migrations apply gatecheck-leaderboard --local",
    "d1:migrate:remote": "wrangler d1 migrations apply gatecheck-leaderboard --remote"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@eslint/js": "^9.15.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^3.90.0"
  }
}
